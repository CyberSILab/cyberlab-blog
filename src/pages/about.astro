---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-Hans">
	<head>
		<BaseHead title={`${SITE_TITLE} · 关于博主`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header active="about" />
		<main>
			<div class="layout solo">
				<section>
					<div class="panel">
						<div class="about-hero">
							<img class="avatar" src="/avatar.png" alt="赛博实验室头像" />
							<p class="bio" style="margin-bottom:0">大家好！这里是赛博实验室。</p>
							<div class="social" style="margin-top:12px;margin-bottom:0">
								<a href="https://www.youtube.com/@%E8%B5%9B%E5%8D%9A%E5%AE%9E%E9%AA%8C%E5%AE%A4" title="YouTube 频道" aria-label="YouTube 频道" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="4.5"/><path d="m10.2 9.4 5 2.6-5 2.6V9.4Z"/></svg></a>
							</div>
						</div>
						<div class="about-body">
							<h2>这里是视频的详细说明</h2>
							<p>视频里总有讲不细的地方，想回头确认某个参数、某条命令时，拖着进度条来回找也很费劲。所以我把这些内容整理成了文字：视频负责把流程演清楚，这里负责让你随时查得到、抄得走、照着做得出来。</p>
							<p>我更希望这里的每一条内容都是有价值的 —— 哪怕只是帮你省下一点时间，那它就是值得的。</p>
							<h2>联系与支持</h2>
							<p>有问题欢迎在视频下方留言交流；觉得内容有用的话，请我喝杯咖啡就是最大的支持。</p>
							<a class="coffee" href="#" data-donate style="max-width:260px;margin:8px auto 0"><svg viewBox="0 0 24 24" style="width:16px;height:16px"><path d="M4 8h12v6a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V8Zm12 1h2a2 2 0 0 1 0 4h-2M8 3v2M12 3v2"/></svg>请我喝咖啡</a>
						</div>
					</div>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
