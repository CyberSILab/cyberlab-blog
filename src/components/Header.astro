---
const {
	active = 'home',
	searchJump = true,
}: {
	active?: 'home' | 'ai-tools' | 'tags' | 'about' | 'none';
	searchJump?: boolean;
} = Astro.props;
---
<header class="site-head">
	<div class="head-inner">
		<a class="logo" href="/"><img class="logo-img" src="/logo.png" alt="赛博实验室" width="126" height="32" /></a>
		<nav class="nav">
			<a href="/" class:list={[{ active: active === 'home' }]}><svg viewBox="0 0 24 24"><path d="M3 10.5 12 4l9 6.5V20a 1 1 0 0 1-1 1h-5v-6H9v6H4a 1 1 0 0 1-1-1v-9.5Z"/></svg><span>网站首页</span></a>
			<a href="/ai-tools/" class:list={[{ active: active === 'ai-tools' }]}><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m10 9 5 3-5 3V9Z"/></svg><span>AI工具</span></a>
			<a href="/tags/" class:list={[{ active: active === 'tags' }]}><svg viewBox="0 0 24 24"><path d="M12 3c2.5 3 5 5.5-1 9 1.5.5 2.5 2 2.5 2C18 11 17 8 12 3 7 8 6.5 11.5 8.5 14s1-1.5 2.5-2C17 8.5 14.5 6 12 3Z"/></svg><span>所有标签</span></a>
			<a href="/about/" class:list={[{ active: active === 'about' }]}><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg><span>关于博主</span></a>
		</nav>
		<label class="search"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 4 4"/></svg><input class="search-input" id="searchInput" type="search" placeholder="搜索关键词..." aria-label="搜索关键词" /></label>
	</div>
</header>
{searchJump && <script is:inline>
	document.getElementById('searchInput').addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && e.target.value.trim()) location.href = '/?q=' + encodeURIComponent(e.target.value.trim());
	});
</script>}
